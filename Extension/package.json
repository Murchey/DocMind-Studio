{
  "name": "docmind-studio",
  "displayName": "DocMind Studio",
  "description": "多 Agent 文档智能处理与知识库管理面板",
  "version": "0.2.0",
  "publisher": "docmind",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:docmind-dms"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "docmind",
          "title": "DocMind Studio",
          "icon": "media/docmind.svg"
        }
      ]
    },
    "languages": [
      {
        "id": "docmind-dms",
        "aliases": [
          "DocMind Project",
          "dms"
        ],
        "extensions": [
          ".dms"
        ],
        "mimetypes": [
          "application/x-docmind-project"
        ]
      }
    ],
    "views": {
      "docmind": [
        {
          "id": "docmind.agents",
          "name": "Agents"
        },
        {
          "id": "docmind.workflows",
          "name": "Workflows"
        },
        {
          "id": "docmind.knowledgeBase",
          "name": "Results"
        }
      ]
    },
    "commands": [
      {
        "command": "docmind.openDashboard",
        "title": "DocMind: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "docmind.refreshAgents",
        "title": "Refresh Agents",
        "icon": "$(refresh)"
      },
      {
        "command": "docmind.refreshWorkflows",
        "title": "Refresh Workflows",
        "icon": "$(refresh)"
      },
      {
        "command": "docmind.refreshKnowledgeBase",
        "title": "Refresh Knowledge Base",
        "icon": "$(refresh)"
      },
      {
        "command": "docmind.runWorkflow",
        "title": "DocMind: Run Workflow",
        "icon": "$(play)"
      },
      {
        "command": "docmind.openKnowledgeBase",
        "title": "DocMind: Open Knowledge Base",
        "icon": "$(book)"
      },
      {
        "command": "docmind.openPath",
        "title": "Open",
        "icon": "$(go-to-file)"
      },
      {
        "command": "docmind.revealPath",
        "title": "Reveal in Explorer",
        "icon": "$(folder-opened)"
      },
      {
        "command": "docmind.exportProject",
        "title": "DocMind: Export Project",
        "icon": "$(package)"
      },
      {
        "command": "docmind.importProject",
        "title": "DocMind: Import Project",
        "icon": "$(cloud-download)"
      },
      {
        "command": "docmind.openDmsFile",
        "title": "DocMind: Open Project File",
        "icon": "$(file-binary)"
      },
      {
        "command": "docmind.deleteProject",
        "title": "DocMind: Delete Project",
        "icon": "$(trash)"
      },
      {
        "command": "docmind.importAgent",
        "title": "DocMind: 导入智能体",
        "icon": "$(cloud-download)"
      },
      {
        "command": "docmind.importWorkflow",
        "title": "DocMind: 导入工作流",
        "icon": "$(cloud-download)"
      },
      {
        "command": "docmind.buildKnowledgeBase",
        "title": "DocMind: 构建知识库",
        "icon": "$(database)"
      }
    ],
    "configuration": {
      "title": "DocMind Studio",
      "properties": {
        "docmind.progressFile": {
          "type": "string",
          "default": "WORKSPACE/.docmind-progress.json",
          "description": "Relative path to the JSON file used by DocMind agents to report live workflow progress."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "docmind.openDashboard",
          "when": "view == docmind.agents || view == docmind.workflows || view == docmind.knowledgeBase",
          "group": "navigation"
        },
        {
          "command": "docmind.refreshAgents",
          "when": "view == docmind.agents",
          "group": "navigation"
        },
        {
          "command": "docmind.refreshWorkflows",
          "when": "view == docmind.workflows",
          "group": "navigation"
        },
        {
          "command": "docmind.refreshKnowledgeBase",
          "when": "view == docmind.knowledgeBase",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "docmind.runWorkflow",
          "when": "view == docmind.workflows",
          "group": "inline"
        },
        {
          "command": "docmind.openPath",
          "when": "viewItem =~ /docmindOpenable/",
          "group": "inline"
        },
        {
          "command": "docmind.revealPath",
          "when": "viewItem =~ /docmindRevealable/",
          "group": "navigation"
        },
        {
          "command": "docmind.exportProject",
          "when": "viewItem =~ /docmindExportable/",
          "group": "inline"
        },
        {
          "command": "docmind.deleteProject",
          "when": "viewItem =~ /docmindExportable/",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.19.0",
    "eslint": "^8.50.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.0"
  }
}
